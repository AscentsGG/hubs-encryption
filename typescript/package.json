{
  "name": "@hubs/private-messages",
  "version": "0.1.0",
  "description": "End-to-end encrypted private conversations on MLS (RFC 9420), built on ts-mls.",
  "keywords": [
    "mls",
    "rfc9420",
    "end-to-end-encryption",
    "e2ee",
    "messaging"
  ],
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/hashes": "2.0.1",
    "ts-mls": "1.6.4"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "rolldown": "1.2.12"
  }
}
